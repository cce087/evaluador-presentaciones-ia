# Variables de entorno para evaluador-presentaciones-ia
# Copia este archivo a .env.local y rellena los valores

# Google Gemini API Key (obtener en https://aistudio.google.com/apikey)
VITE_GEMINI_API_KEY=

# Supabase (opcional - para funcionalidades de base de datos)
# Obtener en https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=